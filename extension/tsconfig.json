{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker.ImportScripts"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": [
      "chrome"
    ],
    "baseUrl": ".",
    "paths": {
      "@vault/crypto/*": [
        "../crypto/src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
